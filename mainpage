opt_irq_cpu() {
    clear
    echo ""
    echo -e "  ${B_BLUE}▶ IRQ BALANCING & CPU AFFINITY${NC}\n"
    scan_effect
    echo ""
    typewriter "  Configuring IRQ balance and CPU pinning..." "$B_BLUE" 0.02

    (
    # Install irqbalance if missing
    if ! command -v irqbalance &>/dev/null; then
        sudo apt-get install -y irqbalance -qq 2>/dev/null
    fi
    sudo systemctl enable irqbalance 2>/dev/null
    sudo systemctl restart irqbalance 2>/dev/null

    # Set CPU frequency scaling to performance
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        echo "performance" | sudo tee "$cpu" > /dev/null 2>/dev/null
    done

    # Disable CPU idle states for latency
    for state in /sys/devices/system/cpu/cpu*/cpuidle/state*/disable; do
        echo "1" | sudo tee "$state" > /dev/null 2>/dev/null
    done
    ) &
    spinner $! "Configuring IRQ + CPU affinity"
    progress_bar 20 "Applying CPU tuning" "$B_BLUE"
    echo ""
    echo -e "  ${B_GREEN}✔  IRQ balanced, CPU affinity set to performance!${NC}"
    echo ""
    read -rp "  Press Enter to continue..." _
}

opt_memory_swap() {
    clear
    echo ""
    echo -e "  ${B_PURPLE}▶ RAM / SWAP / HUGEPAGES OPTIMIZER${NC}\n"
    scan_effect
    echo ""

    TOTAL_RAM=$(free -m | awk '/Mem:/{print $2}')
    SWAP_SIZE=$(( TOTAL_RAM / 2 ))
    echo -e "  ${G}Detected RAM: ${W}${TOTAL_RAM}MB${NC}  →  ${G}Creating ${W}${SWAP_SIZE}MB${G} swap${NC}\n"

    (
    # Drop caches safely
    sync
    echo 3 | sudo tee /proc/sys/vm/drop_caches > /dev/null 2>/dev/null

    # Configure swap if not present
    if ! swapon --show | grep -q "/swapfile"; then
        sudo fallocate -l "${SWAP_SIZE}M" /swapfile 2>/dev/null
        sudo chmod 600 /swapfile 2>/dev/null
        sudo mkswap /swapfile -q 2>/dev/null
        sudo swapon /swapfile 2>/dev/null
        grep -q "/swapfile" /etc/fstab || echo "/swapfile none swap sw 0 0" | sudo tee -a /etc/fstab > /dev/null
    fi

    # Tune swappiness
    sudo sysctl -w vm.swappiness=10 -q 2>/dev/null

    # HugePages for Java/MC workloads
    echo "always" | sudo tee /sys/kernel/mm/transparent_hugepage/enabled > /dev/null 2>/dev/null
