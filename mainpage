# Silent versions
mc_network_tuning_silent() {
    sudo tee /etc/sysctl.d/99-zenith-mc-net.conf > /dev/null << 'EOF'
net.ipv4.tcp_nodelay = 1
net.core.rmem_max = 33554432
net.core.wmem_max = 33554432
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = fq
net.ipv4.tcp_max_syn_backlog = 65536
net.core.somaxconn = 65535
EOF
    modprobe tcp_bbr 2>/dev/null
    sudo sysctl --system -q 2>/dev/null
}

mc_chunk_io_silent() {
    for disk in /sys/block/sd* /sys/block/vd*; do
        [ -d "$disk" ] || continue
        echo 2048 | sudo tee "${disk}/queue/read_ahead_kb" > /dev/null 2>/dev/null
        echo 512 | sudo tee "${disk}/queue/nr_requests" > /dev/null 2>/dev/null
    done
    sudo sysctl -w vm.dirty_ratio=40 -q 2>/dev/null
}

mc_kernel_realtime_silent() {
    sudo sysctl -w kernel.sched_min_granularity_ns=1000000 -q 2>/dev/null
    sudo sysctl -w kernel.sched_latency_ns=4000000 -q 2>/dev/null
}

mc_process_priority_silent() {
    for pid in $(pgrep -f "server.jar" 2>/dev/null); do
        sudo renice -n -5 -p "$pid" 2>/dev/null
        sudo ionice -c 1 -n 2 -p "$pid" 2>/dev/null
        echo -1000 > /proc/$pid/oom_score_adj 2>/dev/null
    done
}

mc_firewall_silent() {
    command -v ufw &>/dev/null || return
    sudo ufw --force reset 2>/dev/null
    sudo ufw default deny incoming 2>/dev/null
    sudo ufw default allow outgoing 2>/dev/null
    sudo ufw allow ssh 2>/dev/null
    sudo ufw allow 25565/tcp 2>/dev/null
    sudo ufw allow 19132/udp 2>/dev/null
    sudo ufw allow 80/tcp 2>/dev/null
    sudo ufw allow 443/tcp 2>/dev/null
    sudo ufw allow 8080/tcp 2>/dev/null
    sudo ufw limit 25565/tcp 2>/dev/null
    sudo ufw --force enable 2>/dev/null
}

