opt_tcp_network() {
    clear
    echo ""
    echo -e "  ${B_CYAN}▶ TCP / NETWORK STACK TUNING${NC}\n"
    scan_effect
    echo ""
    typewriter "  Applying advanced TCP/IP optimizations..." "$B_CYAN" 0.02

    (
    sudo tee /etc/sysctl.d/99-zenith-tcp.conf > /dev/null << 'EOF'
# ── Zenith Cloud TCP Stack Optimizer ──
# Connection handling
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_keepalive_probes = 5
net.ipv4.tcp_max_syn_backlog = 65536
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65536

# Buffer sizes
net.core.rmem_default = 262144
net.core.wmem_default = 262144
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216

# Congestion & performance
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = fq
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_moderate_rcvbuf = 1
net.ipv4.tcp_no_metrics_save = 1

# IPv4 tweaks
net.ipv4.ip_local_port_range = 1024 65535
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1

# Reduce TIME_WAIT
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_max_tw_buckets = 2000000
EOF

    # Load BBR if available
    modprobe tcp_bbr 2>/dev/null
    sudo sysctl --system -q 2>/dev/null
    ) &
    spinner $! "Applying TCP parameters"
    progress_bar 40 "Flushing routing cache" "$B_CYAN"
    sudo ip route flush cache 2>/dev/null
    echo ""
    echo -e "  ${B_GREEN}✔  TCP/Network stack optimized!${NC}"
    echo -e "  ${G}   BBR congestion control, 16MB buffers, TCP Fast Open enabled${NC}"
    echo ""
    read -rp "  Press Enter to continue..." _
}

