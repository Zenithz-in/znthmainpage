opt_disk_io() {
    clear
    echo ""
    echo -e "  ${B_YELLOW}▶ DISK I/O SCHEDULER & QUEUE DEPTH${NC}\n"
    scan_effect
    echo ""
    typewriter "  Tuning block device schedulers..." "$B_YELLOW" 0.02

    (
    for disk in /sys/block/sd* /sys/block/vd* /sys/block/nvme*; do
        [ -d "$disk" ] || continue
        # Set mq-deadline for HDDs, none for NVMe/SSD
        if [[ "$disk" == *nvme* ]]; then
            echo "none" | sudo tee "${disk}/queue/scheduler" > /dev/null 2>/dev/null
        else
            echo "mq-deadline" | sudo tee "${disk}/queue/scheduler" > /dev/null 2>/dev/null
        fi
        # Increase queue depth
        echo 256 | sudo tee "${disk}/queue/nr_requests" > /dev/null 2>/dev/null
        echo 4096 | sudo tee "${disk}/queue/read_ahead_kb" > /dev/null 2>/dev/null
        # Disable rotational hint for SSDs (auto-detect)
        echo 0 | sudo tee "${disk}/queue/rotational" > /dev/null 2>/dev/null
    done

    # Mount options optimization
    sudo tee /etc/sysctl.d/99-zenith-disk.conf > /dev/null << 'EOF'
vm.dirty_writeback_centisecs = 1500
vm.dirty_expire_centisecs = 3000
EOF
    sudo sysctl --system -q 2>/dev/null
    ) &
    spinner $! "Setting I/O schedulers"
    progress_bar 25 "Tuning queue depth" "$B_YELLOW"
    echo ""
    echo -e "  ${B_GREEN}✔  Disk I/O fully tuned!${NC}"
    echo -e "  ${G}   mq-deadline/none schedulers, 256 queue depth, 4MB readahead${NC}"
    echo ""
    read -rp "  Press Enter to continue..." _
}

