    # Set performance governor
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        echo "performance" | sudo tee "$cpu" > /dev/null 2>/dev/null
    done

    # Persist via rc.local
    if [ -f /etc/rc.local ]; then
        grep -q "scaling_governor" /etc/rc.local || \
        sudo sed -i '/^exit 0/i for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo "performance" > "$cpu"; done' /etc/rc.local
