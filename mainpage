mc_chunk_io() {
    clear
    echo ""
    echo -e "  ${B_PURPLE}▶ WORLD CHUNK I/O BOOSTER${NC}\n"
    scan_effect
    echo ""
    typewriter "  Optimizing disk I/O for chunk read/write..." "$B_PURPLE" 0.02

    (
    # Optimize disk for MC world files
    for disk in /sys/block/sd* /sys/block/vd* /sys/block/nvme*; do
        [ -d "$disk" ] || continue
        # Maximize read-ahead for sequential chunk reads
        echo 2048 | sudo tee "${disk}/queue/read_ahead_kb" > /dev/null 2>/dev/null
        # Increase queue depth
        echo 512 | sudo tee "${disk}/queue/nr_requests" > /dev/null 2>/dev/null
        # Disable merge for NVMe (latency)
        [[ "$disk" == *nvme* ]] && echo 2 | sudo tee "${disk}/queue/nomerges" > /dev/null 2>/dev/null
    done

    # VM tuning for chunk workload
    sudo sysctl -w vm.dirty_ratio=40 -q 2>/dev/null
    sudo sysctl -w vm.dirty_background_ratio=10 -q 2>/dev/null
    sudo sysctl -w vm.dirty_writeback_centisecs=500 -q 2>/dev/null

    # Increase inotify for plugin file watching
    sudo sysctl -w fs.inotify.max_user_watches=1048576 -q 2>/dev/null
    sudo sysctl -w fs.inotify.max_queued_events=32768 -q 2>/dev/null
    ) &
    spinner $! "Tuning chunk I/O parameters"
    progress_bar 25 "Optimizing read-ahead & queue" "$B_PURPLE"
    echo ""
    echo -e "  ${B_GREEN}✔  Chunk I/O fully optimized!${NC}"
    echo -e "  ${G}   2MB readahead · 512 queue depth · dirty ratio tuned${NC}"
    echo ""
    read -rp "  Press Enter to continue..." _
}

