# ============================================================
# METRICS & HOSTNAME
# ============================================================

get_metrics() {
    CPU=$(top -bn1 | grep "Cpu(s)" | awk '{printf "%.0f", $2+$4}' 2>/dev/null || echo "??")
    RAM=$(free | grep Mem | awk '{printf "%.0f", $3*100/$2}' 2>/dev/null || echo "??")
    UPT=$(uptime -p | sed 's/up //' 2>/dev/null || echo "Unknown")
    DISK=$(df -h / | awk 'NR==2 {print $5}' 2>/dev/null || echo "??")
    LOAD=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | tr -d ',' 2>/dev/null || echo "?")
    NET_RX=$(cat /proc/net/dev 2>/dev/null | grep -v lo | awk 'NR>2 {rx+=$2} END {printf "%.1f", rx/1024/1024}' || echo "?")

    DESIRED_HOST="zenithcloudinfra"
    CURRENT_HOST=$(hostname)
    if [ "$CURRENT_HOST" != "$DESIRED_HOST" ]; then
        sudo hostnamectl set-hostname "$DESIRED_HOST" 2>/dev/null
        sudo sed -i "s/127.0.1.1.*/127.0.1.1    $DESIRED_HOST/" /etc/hosts 2>/dev/null
        CURRENT_HOST="$DESIRED_HOST"
    fi
}

