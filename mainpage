# ============================================================
# ANIMATION LIBRARY
# ============================================================

spinner() {
    local pid=$1
    local msg="${2:-Processing...}"
    local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local i=0
    tput civis
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r  ${B_CYAN}${frames[$i]}${NC}  ${W}%s${NC}" "$msg"
        i=$(( (i+1) % ${#frames[@]} ))
        sleep 0.08
    done
    printf "\r  ${B_GREEN}✔${NC}  ${W}%s${NC}  ${B_GREEN}Done!${NC}\n" "$msg"
    tput cnorm
}

progress_bar() {
    local total=$1
    local label="${2:-Working}"
    local color="${3:-$B_CYAN}"
    local width=50
    for ((i=0; i<=total; i++)); do
        local filled=$(( i * width / total ))
        local empty=$(( width - filled ))
        local pct=$(( i * 100 / total ))
        local bar=""
        for ((j=0; j<filled; j++)); do bar+="█"; done
        for ((j=0; j<empty; j++)); do bar+="░"; done
        printf "\r  ${color}[${bar}]${NC} ${W}%3d%%${NC}  ${G}%s${NC}" "$pct" "$label"
        sleep 0.04
    done
    echo ""
}

pulse_line() {
    local msg="$1"
    local colors=("$B_CYAN" "$B_PURPLE" "$B_BLUE" "$B_PURPLE" "$B_CYAN")
    for c in "${colors[@]}"; do
        printf "\r  ${c}${msg}${NC}"
        sleep 0.07
    done
    printf "\r  ${W}${msg}${NC}\n"
}

typewriter() {
    local text="$1"
    local color="${2:-$W}"
    local delay="${3:-0.03}"
    printf "  ${color}"
    for ((i=0; i<${#text}; i++)); do
        printf "%s" "${text:$i:1}"
        sleep "$delay"
    done
    printf "${NC}\n"
}

glitch_text() {
    local text="$1"
    local glitch_chars='!@#$%^&*<>?/|\~'
    local len=${#text}
    for pass in 1 2 3; do
        local out=""
        for ((i=0; i<len; i++)); do
            if (( RANDOM % 4 == 0 )); then
                out+="${glitch_chars:$(( RANDOM % ${#glitch_chars} )):1}"
            else
                out+="${text:$i:1}"
            fi
        done
        printf "\r  ${B_PURPLE}%s${NC}" "$out"
        sleep 0.06
    done
    printf "\r  ${W}%s${NC}\n" "$text"
}

countdown_bar() {
    local secs=$1
    local label="${2:-Applying}"
    for ((i=secs; i>=0; i--)); do
        local filled=$(( (secs - i) * 20 / secs ))
        local bar=""
        for ((j=0; j<filled; j++)); do bar+="▰"; done
        for ((j=filled; j<20; j++)); do bar+="▱"; done
        printf "\r  ${B_ORANGE}[%s]${NC} ${W}%ds${NC}  ${G}%s...${NC}" "$bar" "$i" "$label"
        sleep 1
    done
    echo ""
}

