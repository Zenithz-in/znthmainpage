    echo -e "  ${B_YELLOW}▶ PORT OPTIMIZATION FOR MC${NC}\n"
    scan_effect
    echo ""
    typewriter "  Configuring port settings for Minecraft..." "$B_YELLOW" 0.02

    (
    # tc qdisc for low latency on MC port
    MC_PORT="${MC_PORT:-25565}"
    IFACE=$(ip route | grep default | awk '{print $5}' | head -1)

    if [ -n "$IFACE" ]; then
        # Install tc if needed
        sudo apt-get install -y iproute2 -qq 2>/dev/null

        # Clear existing qdiscs
        sudo tc qdisc del dev "$IFACE" root 2>/dev/null

        # Add fq_codel for low latency
        sudo tc qdisc add dev "$IFACE" root fq_codel 2>/dev/null

        # Mark MC traffic for priority
        sudo iptables -t mangle -A OUTPUT -p tcp --sport "$MC_PORT" -j DSCP --set-dscp-class EF 2>/dev/null
        sudo iptables -t mangle -A OUTPUT -p udp --sport "$MC_PORT" -j DSCP --set-dscp-class EF 2>/dev/null
    fi
    ) &
    spinner $! "Setting port QoS for MC traffic"
    progress_bar 20 "Applying traffic shaping" "$B_YELLOW"
    echo ""
    echo -e "  ${B_GREEN}✔  MC port traffic prioritized!${NC}"
